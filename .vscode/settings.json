{
  // i18n-ally merges every localesPath into one dictionary. Console, site and
  // flow each have their own keys, so listing more than one produces a false
  // "N missing (en, fr)" on every t() call. Point this at the app you are
  // translating; TypeScript already enforces FR/EN parity inside each app.
  "i18n-ally.localesPaths": ["web/console/i18n"],
  "i18n-ally.pathMatcher": "{locale}.json",
  "i18n-ally.keystyle": "nested",
  "i18n-ally.sourceLanguage": "fr",
  "i18n-ally.displayLanguage": "fr",
  "i18n-ally.enabledParsers": ["json"],
  "java.debug.settings.forceBuildBeforeLaunch": true,
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.import.maven.enabled": true,
  "java.import.gradle.enabled": false,
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/web/**",
    "**/.next/**",
    "**/packages/**"
  ],
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx4G -Xms100m -Xlog:disable",
  "java.compile.nullAnalysis.mode": "automatic"
}
