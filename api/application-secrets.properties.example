# Copier vers application-secrets.properties (racine du module api/).
# Ne pas committer le fichier réel.

# SMTP MINTP / nano-tech — mot de passe uniquement ici ou via KYC_SMTP_PASSWORD
spring.mail.password=

# Stripe test (M3). Ne pas committer sk_live_ / pk_live_.
# kyc.stripe.mode=stripe
# kyc.stripe.secret-key=sk_test_...   (clé secrète, pas pk_test_)
# kyc.stripe.webhook-secret=whsec_...  (signature webhook, pas sk_test_)

# AWS — clés PAR SERVICE dans ce fichier (pas AWS CLI, pas ~/.aws/credentials).
# Runbook : docs/MVP/guide-aws-iam-local.md
#
# kyc.aws.enabled=true
# kyc.aws.region=ca-central-1
#
# kyc.aws.textract.access-key-id=AKIA...
# kyc.aws.textract.secret-access-key=...
#
# kyc.aws.rekognition.access-key-id=AKIA...
# kyc.aws.rekognition.secret-access-key=...
#
# kyc.aws.s3.enabled=true
# kyc.aws.s3.bucket=recognizme-media-dev
# kyc.aws.s3.key-prefix=kyc/
# kyc.aws.s3.access-key-id=AKIA...
# kyc.aws.s3.secret-access-key=...
#
# Sans kyc.aws.enabled, le live reste en provider_unavailable.
# Sans kyc.aws.s3.enabled + bucket + clés S3, les images restent sur le disque local.

# Document IA — OpenAI. La clé ne va jamais dans git ni dans les logs.
# kyc.document-ia.provider=openai
# kyc.document-ia.openai-api-key=sk-...
# kyc.document-ia.openai-model=gpt-4.1-mini
