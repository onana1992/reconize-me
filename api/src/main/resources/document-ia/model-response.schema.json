{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recogniz-me.local/document-ia/model-response.schema.json",
  "title": "Document IA model response",
  "type": "object",
  "additionalProperties": true,
  "required": ["detection"],
  "properties": {
    "documentDetected": { "type": "boolean" },
    "detection": {
      "enum": [
        "NO_DOCUMENT",
        "DOCUMENT_PRESENT",
        "PARTIALLY_VISIBLE",
        "CROPPED",
        "MULTIPLE_DOCUMENTS",
        "TOO_SMALL",
        "UNREADABLE"
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "blur": { "type": "boolean" },
        "glare": { "type": "boolean" },
        "cropped": { "type": "boolean" },
        "partiallyVisible": { "type": "boolean" },
        "multipleDocuments": { "type": "boolean" },
        "tooSmall": { "type": "boolean" },
        "lowLight": { "type": "boolean" },
        "overexposed": { "type": "boolean" },
        "tilted": { "type": "boolean" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "code": { "type": "string" },
        "country": { "type": "string" },
        "documentType": { "type": "string" },
        "version": { "type": "string" },
        "side": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "rawText": { "type": "string" },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "boundingBox": {
            "type": ["object", "null"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 },
              "width": { "type": "number", "minimum": 0, "maximum": 1 },
              "height": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["field"],
        "properties": {
          "field": { "type": "string" },
          "value": { "type": ["string", "number", "boolean", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "enum": ["VISUAL_TEXT", "MRZ", "VISUAL_AND_MRZ"] }
        }
      }
    }
  }
}
